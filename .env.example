# ── Ollama ────────────────────────────────────────────────────────────────────
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# linux-gpu profile: DOCKER_OLLAMA_URL=http://ollama:11434

DEFAULT_MODEL=gemma3n:e4b
DEFAULT_TEMPERATURE=0.3
NUM_CTX=64000
DENSE_WEIGHT=0.8
SPARSE_WEIGHT=0.2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── RAG retrieval ─────────────────────────────────────────────────────────────
# چند تکه (chunk) نهایی که به مدل داده می‌شه. عدد پایین + reranker بهتر از
# عدد بالا + بدون reranker جواب می‌ده (نویز کمتر = دقت بیشتر).
RAG_TOP_K=15

# ── Reranker (bge-reranker-v2-m3) ─────────────────────────────────────────────
USE_RERANKER=1
# چند کاندید از RRF قبل از rerank (بالاتر از ~32 فقط latency می‌ده، دقت کمی)
RERANK_CANDIDATES=24
# سقف سخت برای سرعت چت تعاملی
RERANK_POOL_CAP=32

USE_CUDA=1
DOCKER_RUNTIME=nvidia

# ── Upload limits (MB) ────────────────────────────────────────────────────────
# حداکثر حجم هر فایل PDF/Word برای پایگاه دانش
MAX_UPLOAD_MB=500
# حداکثر حجم هر فایل PDF/Word/متنی که داخل چت پیوست می‌شه
CHAT_ATTACH_MAX_DOC_MB=15

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change_this_password

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
TOKEN_TTL_HOURS=24

# ── Default Admin Account (created on first startup) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# ── Public HTTPS port (nginx) ────────────────────────────────────────────────
# روی ویندوز از بازه پورت‌های رزرو‌شده دوری کن (netsh int ipv4 show excludedportrange protocol=tcp)
HTTPS_PORT=18443