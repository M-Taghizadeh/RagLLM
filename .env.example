USE_CUDA=0          # USE_CUDA=1 for GPU
DOCKER_RUNTIME=runc # DOCKER_RUNTIME=nvidia for GPU

# ── Ollama ────────────────────────────────────────────────────────────────────
# Manual (uvicorn on host):
OLLAMA_URL=http://localhost:11434
# Docker container → Ollama on host (Windows/Mac or native Linux Ollama):
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# Docker container → Ollama service (--profile linux-gpu):
# DOCKER_OLLAMA_URL=http://ollama:11434

DEFAULT_MODEL=gemma3:4b
DEFAULT_TEMPERATURE=0.3
NUM_CTX=8192

# ── RAG settings ──────────────────────────────────────────────────────────────
DEFAULT_TOP_K=8
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change_this_password

# Manual local DB (required when running uvicorn outside Docker):
DATABASE_URL=postgresql+asyncpg://ragbot:change_this_password@localhost:5432/ragbot
# Inside Docker Compose, postgres starts automatically and DATABASE_URL
# is overridden to postgresql+asyncpg://...@postgres:5432/...

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
TOKEN_TTL_HOURS=24

# ── Default Admin Account (created on first startup) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
