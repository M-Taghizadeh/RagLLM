USE_CUDA=0 # USE_CUDA=1 for gpu
DOCKER_RUNTIME=runc # DOCKER_RUNTIME=nvidia for gpu

# ── Ollama ────────────────────────────────────────────────────────────────────
# اگه ollama داخل docker-compose هست:   http://ollama:11434
# اگه ollama روی host سرور هست:         http://host.docker.internal:11434
# اگه ollama روی IP خاصی هست:           http://<IP>:11434
OLLAMA_URL=http://host.docker.internal:11434

# مدل پیش‌فرض Ollama
DEFAULT_MODEL=gemma3:4b

# ── LLM settings ──────────────────────────────────────────────────────────────
DEFAULT_TEMPERATURE=0.3

# ── Context window ──────────────────────────────────────────────────────────────
NUM_CTX=8192

# ── RAG settings ──────────────────────────────────────────────────────────────
DEFAULT_TOP_K=8

# وزن جستجوی معنایی (FAISS) در برابر کلیدواژه‌ای (BM25) — جمع باید ۱ باشد
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# تنظیمات chunking اسناد
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
