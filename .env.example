DEFAULT_MODEL=gemma4
OLLAMA_URL=http://localhost:11434
DEFAULT_TEMPERATURE=0.3
DEFAULT_TOP_K=8

# وزن جستجوی معنایی (FAISS) در برابر کلیدواژه‌ای (BM25)
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# پنجره context مدل — مقدار را متناسب با مدل انتخابی تنظیم کنید
# مثال: qwen2.5:14b → 8192 | gemma3:27b → 32768 | مدل‌های 256k → 131072
NUM_CTX=32000

# تنظیمات chunking اسناد
# CHUNK_SIZE: حداکثر کاراکتر هر قطعه (پیش‌فرض: 1000)
# CHUNK_OVERLAP: همپوشانی بین قطعات (پیش‌فرض: 150)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
